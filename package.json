{
  "name": "traceflow",
  "version": "0.1.0",
  "private": true,
  "description": "研发全链路追溯与变更影响管理 PoC：需求 → 代码 → 测试 → 回归",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
